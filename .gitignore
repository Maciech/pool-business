# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache

# Environment & secrets (never commit API keys or passwords)
.env
.env.*
!.env.example
*.pem
*.key

# Logs
logs/
*.log

# IDEs and editors (the shared WebStorm inspection profile is kept)
.idea/*
!.idea/inspectionProfiles/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code (shared settings stay, personal ones are ignored)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Claude Code (personal settings and local worktrees)
.claude/settings.local.json
.claude/worktrees/

# Miscellaneous
/.angular/
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
